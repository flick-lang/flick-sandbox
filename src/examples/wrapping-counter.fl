// Integers can be any width: a u3 holds 0 to 7, so 7 + 1 wraps to 0

extern fn putchar(u8 c) u8

pub fn main() u8 {
    u3 counter = 0
    u64 printed = 0
    while printed < 12 {
        putchar(48 + (u8) counter)
        putchar(32) // space
        counter += 1
        printed += 1
    }
    putchar(10) // newline
    ret 0
}
