// Think of a number from 1 to 100 and this program will guess it.
// Answer each guess with h (higher), l (lower) or y (yes), then Enter

extern fn putchar(u8 c) u8
extern fn getchar() i32
extern fn fflush(u64 stream) i32

fn printnum(u64 n) {
    u64 divisor = 1
    while n / divisor > 9 {
        divisor *= 10
    }
    while divisor > 0 {
        u8 digit = (u8) (n / divisor % 10)
        putchar(48 + digit)
        divisor /= 10
    }
}

// Reads one answer, skipping leftover newlines
fn readanswer() i32 {
    i32 newline = 10
    i32 answer = getchar()
    while answer == newline {
        answer = getchar()
    }
    ret answer
}

pub fn main() u8 {
    i32 higher = 104 // h
    i32 lower = 108 // l
    u64 low = 1
    u64 high = 100
    while low < high {
        u64 guess = (low + high) / 2
        printnum(guess)
        putchar(63) // ?
        putchar(32) // space
        fflush(0) // flush stdout

        i32 answer = readanswer()
        if answer == higher {
            low = guess + 1
        } else if answer == lower {
            high = guess - 1
        } else {
            low = guess
            high = guess
        }
    }

    printnum(low)
    putchar(33) // !
    putchar(10) // newline
    ret 0
}
