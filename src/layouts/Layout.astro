---
import { Font } from 'astro:assets';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { THEME_KEY } from '@/consts';
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" class="bg-surface font-sans text-fg antialiased scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Write and run Flick programs in your browser." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <!-- Inline and in the head so the theme is set before first paint. ThemeToggle stores the user's pick. -->
    <script is:inline define:vars={{ THEME_KEY }}>
      const root = document.documentElement;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const stored = () => {
        try {
          return localStorage.getItem(THEME_KEY);
        } catch {}
      };
      const apply = () => (root.dataset.theme = stored() ?? (system.matches ? 'dark' : 'light'));

      apply();
      system.addEventListener('change', apply);
    </script>
  </head>
  <!-- text-sm is on body because on html it would shrink the rem, and with it every other size. -->
  <body class="text-sm">
    <header class="flex h-12 items-center gap-1 border-b border-line px-3 sm:gap-2">
      <a class="text-[0.9375rem] font-semibold tracking-tight sm:mr-2" href="/">
        Flick <span class="font-normal text-muted max-[30rem]:hidden">Sandbox</span>
      </a>
      <slot name="actions">
        <span class="flex-1"></span>
        <ThemeToggle />
      </slot>
    </header>
    <slot />
  </body>
</html>
